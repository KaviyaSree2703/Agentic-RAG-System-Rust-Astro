---
// src/components/chat/ChatComposer.astro
// Enhanced Bottom Message Composer with draft preservation and upload progress
---

<div class="chat-composer-container">
  <div class="composer-inner">
    <!-- Drag & Drop / Upload Boundary -->
    <div class="composer-box" id="composerDropZone">
      <!-- File Attachment Chips Area -->
      <div class="composer-attachments" id="composerAttachmentsArea" style="display: none;"></div>

      <div class="composer-input-row">
        <!-- Paperclip Attachment Action -->
        <button 
          type="button" 
          class="icon-btn" 
          id="composerAttachBtn" 
          aria-label="Attach knowledge file" 
          title="Attach document to context"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
          </svg>
        </button>

        <!-- Hidden Native File Picker -->
        <input type="file" id="composerFileInput" multiple accept=".pdf,.txt,.md,.json,.csv" style="display: none;" />

        <!-- Multiline Textarea Input -->
        <textarea
          id="composerQueryInput"
          class="composer-textarea"
          rows="1"
          placeholder="Ask a technical question or investigate evidence... (Enter to send, Shift+Enter for newline)"
          autocomplete="off"
        ></textarea>

        <!-- Action Controls: Send / Stop -->
        <div class="composer-controls">
          <button 
            type="button" 
            class="btn-composer-stop" 
            id="composerStopBtn" 
            title="Cancel generation" 
            style="display: none;"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <rect x="6" y="6" width="12" height="12" rx="2"></rect>
            </svg>
          </button>

          <button 
            type="submit" 
            class="btn-composer-send" 
            id="composerSendBtn" 
            aria-label="Send query" 
            title="Send query (Enter)" 
            disabled
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="19" x2="12" y2="5"></line>
              <polyline points="5 12 12 5 19 12"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Real-time upload progress notification -->
    <div id="composerUploadFeedback" style="display:none; font-size:11px; color:var(--brand-cyan); margin-top:4px; padding:0 4px;"></div>

    <div class="composer-disclaimer">
      Answers are synthesized with traceable citations from verified evidence records.
    </div>
  </div>
</div>
